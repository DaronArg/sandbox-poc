{
  "name": "assessment",
  "productName": "Assessment",
  "version": "0.1.0",
  "description": "Aplicacion de escritorio del alumno (Electron): IDE y front dentro de una ventana",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-assets.js",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test \"out/test/*.test.js\"",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "~5.9.3"
  }
}
